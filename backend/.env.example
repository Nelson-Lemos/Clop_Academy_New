# --- Aplicação -----------------------------------------------------------
PROJECT_NAME=CLOP Academy
ENVIRONMENT=development
DEBUG=false

# --- Base de dados (MySQL) ----------------------------------------------
DATABASE_URL=mysql+pymysql://root@localhost:3306/clop_academy

# --- Segurança -----------------------------------------------------------
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_este_segredo_por_um_valor_aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- CORS / frontend -----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_SITE_URL=http://localhost:5173

# --- Uploads -------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- Seed / primeiro administrador ---------------------------------------
SEED_ADMIN_EMAIL=admin@clop.academy
SEED_ADMIN_PASSWORD=TroqueEstaPassword_2026!
SEED_ADMIN_NAME=Administrador CLOP

# --- Identidade institucional (opcional: sobrepoe os valores por omissão)
INSTITUTION_NAME=CLOP Academia Digital, LDA.
INSTITUTION_AREA=Educação Financeira & Mercados
INSTITUTION_ADDRESS=Kinaxixi, Rua da Missão, Edifício 93, Apartamento 8A, Luanda, Angola
INSTITUTION_UNITEL=994 365 4853
INSTITUTION_AFRICELL=955 517 094
INSTITUTION_EMAIL=infocloptrader@gmail.com

# --- Integrações de mercados (opcional) ----------------------------------
# Sem chaves configuradas o portal apresenta um estado informativo,
# sem apresentar dados ficticios como cotacoes reais.
MARKET_INTERNATIONAL_API_URL=
MARKET_INTERNATIONAL_API_KEY=
MARKET_BODIVA_API_URL=
MARKET_BODIVA_API_KEY=
MARKET_CACHE_TTL_SECONDS=300
MARKET_REQUEST_TIMEOUT_SECONDS=10
